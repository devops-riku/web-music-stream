# Spotify API Credentials
# Get these from the Spotify Developer Dashboard: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# The URL Spotify redirects to after login (Backend Callback)
SPOTIFY_REDIRECT_URI=http://localhost:8000/api/auth/callback

# The URL the Backend redirects to after successful login (Frontend Callback)
FRONTEND_REDIRECT_URI=http://localhost:5173/callback

# Application Settings
SECRET_KEY=supersecretkeyreplaceinproduction
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=music_stream
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
